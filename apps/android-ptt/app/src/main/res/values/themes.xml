<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    Pure Compose app — the XML theme only needs to suppress the ActionBar
    and set the window background. All visual theming is done in PushcommTheme.
  -->
  <style name="Theme.PushcommPtt" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="colorPrimary">@color/orange_500</item>
    <item name="colorAccent">@color/orange_500</item>
    <item name="android:windowBackground">@color/black</item>
    <item name="android:statusBarColor">@color/black</item>
    <item name="android:navigationBarColor">@color/black</item>
  </style>
</resources>
