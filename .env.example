# PushComm Community Edition — environment template.
#
#   cp .env.example .env      then fill in the values marked CHANGE ME.
#
# .env is gitignored. Never commit real secrets.
# Generate each secret with:  openssl rand -hex 32

# ─── Secrets (required) ──────────────────────────────────────────────────────

# PostgreSQL password.
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Signs API access/refresh tokens. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Shared secret between the API, the LiveKit SFU and the egress recorder.
# It must be IDENTICAL in three places:
#   1. here
#   2. docker/livekit.yaml  → keys.pushcomm
#   3. docker/egress.yaml   → api_secret
LIVEKIT_API_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─── Addresses (required) ────────────────────────────────────────────────────

# The LiveKit address browsers and phones connect to. Must be reachable from
# your clients, not just from the server. With the tls profile and a domain:
#   wss://live.example.com
# For a LAN-only trial you can use  ws://<server-lan-ip>:7880  (note: browsers
# require HTTPS for microphone access, so a LAN trial without TLS only works
# from localhost).
LIVEKIT_PUBLIC_URL=CHANGE_ME_wss://live.example.com

# Comma-separated list of origins allowed to call the API — your dispatch
# console and management dashboard. No trailing slashes.
CORS_ORIGIN=https://dispatch.example.com,https://manage.example.com

# ─── Storage paths on the host ───────────────────────────────────────────────

# Where PTT recordings are written. Defaults to ./data/recordings next to the
# compose file. Point this at a disk with room to grow.
RECORDINGS_HOST_PATH=./data/recordings

# ─── Optional ────────────────────────────────────────────────────────────────

# Database name/user. Change only before the first start.
# DB_NAME=pushcomm
# DB_USER=pushcomm

# LiveKit API key. Must match the key NAME in docker/livekit.yaml and
# api_key in docker/egress.yaml.
# LIVEKIT_API_KEY=pushcomm

# How the API reaches LiveKit from inside the container network.
# LIVEKIT_URL=ws://host.docker.internal:7880

# Vector tile server (only used with the `tiles` compose profile).
# MARTIN_URL=http://martin:3000

# Set false to skip automatic DB migrations on API boot (not recommended).
# AUTO_MIGRATE=true

# Token lifetimes.
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d

# Geocoding (address search on the map). Defaults use the public Photon and
# Nominatim instances — fine for light use, but their usage policies apply.
# Point these at your own instances for production.
# GEOCODER_PHOTON_URL=https://photon.komoot.io
# GEOCODER_NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=PushComm-CE/1.0 (contact@example.com)
# GEOCODER_COUNTRY_CODE=us
# Bias results toward your service area: minLon,minLat,maxLon,maxLat
# GEOCODER_BIAS_BBOX=

# Push notifications (optional). Needed to wake the Android app for incoming
# calls, messages and SOS while it is backgrounded. Put the JSON service-account
# key from the same Firebase project as app/google-services.json on the host,
# set the path below, and uncomment the matching volume mount + env line in
# docker/docker-compose.yml (service: api).
# FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./secrets/firebase-service-account.json
